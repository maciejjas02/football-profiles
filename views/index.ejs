<!doctype html>
<html lang="pl">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Football Profiles — Logowanie</title>
  <link rel="icon" href="data:," />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css" />
  <link rel="icon" type="image/png" href="/images/logo.png" />
</head>

<body class="login-page">
  <header class="topbar">
    <div class="brand-mini">
      <img src="/images/logo.png" alt="Football Profiles" class="topbar-logo" width="50" height="50" />
      <strong>Football Profiles</strong>
    </div>
    <div id="authBar" class="authbar">
      <span id="authStatus">Nie zalogowany</span>
      <button id="logoutBtn" class="btn btn-ghost" hidden>Wyloguj</button>
    </div>
  </header>

  <div id="banner" class="banner" role="status" aria-live="polite" hidden></div>

  <div class="bg">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="grid"></div>
  </div>

  <main class="container">
    <section class="hero">
      <div class="logo">
        <img src="/images/logo.png" alt="Football logo" class="logo-png" width="80" height="80" />
      </div>

      <h1>Football <span>Profiles</span></h1>
      <p>Twoje centrum profili piłkarzy.</p>
      <ul class="bullets">
        <li>Statystyki zawodników</li>
        <li>Możliwość kupna koszulek</li>
        <li>I wiele więcej</li>
      </ul>
    </section>

    <section class="card">
      <div class="tabs">
        <button id="tabLogin" class="tab active" type="button">Logowanie</button>
        <button id="tabRegister" class="tab" type="button">Rejestracja</button>
      </div>

      <div id="viewLogin">
        <h2>Zaloguj się</h2>
        <p class="hint">Demo: <strong>admin@example.com</strong> / <strong>admin1234</strong></p>

        <form id="loginForm" autocomplete="on" novalidate>
          <label for="login">Email lub nazwa użytkownika</label>
          <input id="login" name="login" type="text" placeholder="np. admin@example.com" required />

          <label for="password">Hasło</label>
          <div class="password">
            <input id="password" name="password" type="password" placeholder="••••••••" required />
            <button type="button" id="togglePw" class="btn icon" aria-label="Pokaż hasło">👁️</button>
          </div>

          <div class="row">
            <label class="checkbox">
              <input type="checkbox" id="remember" checked />
              <span>Zapamiętaj login</span>
            </label>
            <a href="#" class="link">Nie pamiętasz hasła?</a>
          </div>

          <button class="btn btn-primary" type="submit">Zaloguj</button>
          <p id="error" class="error" role="alert" aria-live="polite"></p>
        </form>

        <div class="divider"><span>albo</span></div>
        <div class="oauth" id="oauthBox">
          <a class="btn btn-google" href="/auth/google"><img src="/icons/google.png" alt="" width="18" height="18">
            Zaloguj przez Google</a>
          <a class="btn btn-github" href="/auth/github"><img src="/icons/git.gif" alt="" width="18" height="18"> Zaloguj
            przez GitHub</a>
        </div>
      </div>

      <div id="viewRegister" style="display:none">
        <h2>Załóż konto</h2>
        <p class="hint">Wymagane: email, nazwa użytkownika i hasło (min. 6 znaków).</p>

        <form id="registerForm" autocomplete="on" novalidate>
          <label for="reg_email">Email</label>
          <input id="reg_email" name="email" type="email" placeholder="np. jan.kowalski@..." required />

          <label for="reg_username">Nazwa użytkownika</label>
          <input id="reg_username" name="username" type="text" placeholder="np. jank" required minlength="3" />

          <label for="reg_name">Imię i nazwisko (opcjonalnie)</label>
          <input id="reg_name" name="name" type="text" placeholder="Jan Kowalski" />

          <label for="reg_password">Hasło</label>
          <div class="password">
            <input id="reg_password" name="password" type="password" placeholder="••••••••" required minlength="6" />
            <button type="button" id="toggleRegPw" class="btn icon" aria-label="Pokaż hasło">👁️</button>
          </div>

          <div class="password-strength">
            <div class="password-strength-bar" id="password-strength-bar"></div>
          </div>

          <div class="password-requirements">
            <div class="requirement" id="req-length">
              <span class="req-icon">○</span> <span>Minimum 6 znaków</span>
            </div>
            <div class="requirement" id="req-uppercase">
              <span class="req-icon">○</span> <span>Jedna wielka litera</span>
            </div>
            <div class="requirement" id="req-number">
              <span class="req-icon">○</span> <span>Jedna cyfra</span>
            </div>
          </div>

          <label for="reg_password2">Powtórz hasło</label>
          <div class="password">
            <input id="reg_password2" name="password_confirm" type="password" placeholder="••••••••" required
              minlength="6" />
            <button type="button" id="toggleRegPw2" class="btn icon" aria-label="Pokaż hasło">👁️</button>
          </div>

          <div class="row">
            <span></span>
            <small class="muted">Rejestrując się, akceptujesz regulamin.</small>
          </div>

          <button class="btn btn-primary" type="submit">Utwórz konto</button>
          <p id="reg_error" class="error" role="alert" aria-live="polite"></p>
        </form>

        <div class="divider"><span>albo</span></div>
        <div class="oauth">
          <a class="btn btn-google" href="/auth/google"><img src="/icons/google.png" alt="" width="18" height="18">
            Zarejestruj przez Google</a>
          <a class="btn btn-github" href="/auth/github"><img src="/icons/git.gif" alt="" width="18" height="18">
            Zarejestruj przez GitHub</a>
        </div>
      </div>
    </section>

  </main>

  <script src="/app.js" type="module"></script>
  <%- include('partials/footer') %>
</body>

</html>