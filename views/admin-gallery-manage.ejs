<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="UTF-8">
    <title>Admin - Zarządzaj Sliderem Galerii</title>
    <link rel="stylesheet" href="styles.css">
    <style>
        .dashboard-container {
            max-width: 1400px;
            margin: 100px auto 0;
            padding: 0 20px 40px;
            width: 100%;
            display: block;
        }

        .manage-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            align-items: start;
            margin-top: 30px;
        }

        @media (max-width: 768px) {
            .manage-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <link rel="icon" type="image/png" href="/images/logo.png" />
</head>

<body>
    <header class="topbar">
        <div class="topbar-content">
            <div class="logo-section">
                <img src="/images/logo.png" class="topbar-logo" alt="Logo Football Profiles" />
                <span class="site-title">Football Profiles</span>
            </div>
            <%- include('partials/navbar', { activePage, user }) %>
            <div class="topbar-actions">
                <div style="position:relative;">
                    <button id="notificationsBtn" class="icon-button" aria-label="Powiadomienia" style="display:none;">
                        <span>🔔</span>
                        <span id="notificationBadge" class="notification-badge" style="display:none;">0</span>
                    </button>
                    <div id="notificationsDropdown" class="notification-dropdown" style="display:none;">
                        <div class="notification-header">
                            <h3>Powiadomienia</h3>
                            <button id="markAllReadBtn" class="btn-link">Oznacz wszystkie jako przeczytane</button>
                        </div>
                        <div class="notification-list" id="notificationsList">
                            <div class="notification-empty">Brak powiadomień.</div>
                        </div>
                    </div>
                </div>

                <div id="authBar" class="authbar"><span id="who">...</span><button id="logoutBtn"
                        class="btn btn-ghost">Wyloguj</button></div>
            </div>
        </div>
    </header>

    <div class="dashboard-container">
        <h1 class="page-title">🛠️ Zarządzanie Sliderem</h1>
        <div class="sub-nav">
            <a href="admin-gallery-upload.html" class="sub-nav-link">Upload zdjęć</a>
            <a href="admin-gallery-manage.html" class="sub-nav-link active">Zarządzaj Sliderem</a>
            <a href="gallery.html" class="sub-nav-link">Podgląd dla Użytkownika</a>
        </div>

        <div class="manage-grid">
            <div class="admin-panel">
                <h2>Kolekcje (Galerie)</h2>
                <div id="collectionsList" class="collections-grid">
                    <div class="loading">Ładowanie...</div>
                </div>

                <div style="border-top: 1px solid #333; padding-top: 20px; margin-top: 20px;">
                    <h3>Utwórz nową kolekcję</h3>
                    <input type="text" id="collectionName" class="form-input" placeholder="Nazwa kolekcji"
                        style="margin-bottom: 10px;">
                    <textarea id="collectionDescription" class="form-textarea" rows="2"
                        placeholder="Opis kolekcji"></textarea>
                    <button id="createCollectionBtn" class="btn btn-primary" style="margin-top: 10px;">Utwórz</button>
                </div>
            </div>

            <div class="admin-panel">
                <h2 id="itemsHeader">Elementy kolekcji</h2>
                <div id="collectionActions" style="margin-bottom: 15px; display:flex; gap:10px; flex-wrap: wrap;">
                    <select id="availableImagesSelect" class="form-select" style="flex: 1; min-width: 180px;">
                        <option value="">Wybierz obrazek do dodania...</option>
                    </select>
                    <button id="addImageToCollectionBtn" class="btn btn-secondary">➕ Dodaj</button>
                    <button id="saveOrderBtn" class="btn btn-success" style="flex: 1;">💾 Zapisz Kolejność (Drag &
                        Drop)</button>
                </div>

                <div class="slider-items" id="collectionItems">
                    <div class="empty-state">Wybierz kolekcję, aby zarządzać elementami.</div>
                </div>
            </div>
        </div>
    </div>

    <script src="/admin-gallery-manage.js" type="module"></script>
    <script type="module" src="/theme-manager.js"></script>
  <%- include('partials/footer') %>
</body>

</html>