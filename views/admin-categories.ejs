<!DOCTYPE html>
<html lang="pl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Zarządzanie Kategoriami</title>
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="stylesheet" href="styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    .dashboard-container {
      max-width: 1400px;
      margin: 100px auto 0;
      padding: 0 20px 40px;
      width: 100%;
      display: block;
    }

    .categories-grid-admin {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 30px;
      align-items: flex-start;
    }

    @media (max-width: 1000px) {
      .categories-grid-admin {
        grid-template-columns: 1fr;
      }
    }

    .role-badge {
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: bold;
      text-transform: uppercase;
      display: inline-block;
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-content">
      <div class="logo-section"><img src="/images/logo.png" class="topbar-logo" alt="Logo" /><span
          class="site-title">Football Profiles</span></div>
      <%- include('partials/navbar', { activePage, user }) %>
      <div class="topbar-actions">
        <div id="authBar" class="authbar"><span id="who">...</span><button id="logoutBtn"
            class="btn btn-ghost">Wyloguj</button></div>
      </div>
    </div>
  </header>

  <div class="dashboard-container">
    <div class="page-header">
      <h1 class="page-title">📁 Administracja Forum</h1>
    </div>

    <div class="categories-grid-admin">

      <div class="admin-panel">
        <h2>Utwórz Kategorię</h2>
        <div id="createCatContainer">
          <div class="form-group">
            <label for="categoryName">Nazwa kategorii *</label>
            <input type="text" id="categoryName" class="form-input" placeholder="Nazwa kategorii" />
          </div>
          <div class="form-group">
            <label for="categorySlug">Slug (unikalny link) *</label>
            <input type="text" id="categorySlug" class="form-input" placeholder="np. dyskusje-o-lidze" />
          </div>
          <div class="form-group">
            <label for="categoryDescription">Opis</label>
            <textarea id="categoryDescription" class="form-textarea" rows="2" placeholder="Opis..."></textarea>
          </div>
          <div class="form-group">
            <label for="parentCategory">Kategoria nadrzędna</label>
            <select id="parentCategory" class="form-select">
              <option value="">Brak (główna kategoria)</option>
            </select>
          </div>
          <button id="submitCategoryBtn" class="btn btn-primary" style="margin-top: 10px;">Utwórz Kategorię</button>
        </div>

        <div class="admin-panel"
          style="margin-top: 30px; background: rgba(0,0,0,0.2); border: 1px solid #444; padding: 20px;">
          <h2>Lista Kategorii</h2>
          <div id="categoriesList">Ładowanie...</div>
        </div>
      </div>

      <div class="admin-panel">
        <h2>🎨 Zarządzanie Motywami</h2>
        <p style="font-size:12px; opacity:0.7;">Edytuj kolory lub dodaj nowy zestaw.</p>

        <div id="themesList" class="themes-grid">Ładowanie...</div>

        <hr style="border-color: rgba(255,255,255,0.1); margin: 20px 0;">

        <h3>Edytuj / Dodaj Motyw</h3>
        <form id="themeForm">
          <input type="hidden" id="themeId">
          <div class="form-group">
            <label>Nazwa Motywu</label>
            <input type="text" id="themeName" class="form-input" required>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Główny (Primary)</label>
              <input type="color" id="themePrimary" class="form-input" style="height:40px;">
            </div>
            <div class="form-group">
              <label>Drugorzędny (Sec)</label>
              <input type="color" id="themeSecondary" class="form-input" style="height:40px;">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Tło Start (Gradient)</label>
              <input type="color" id="themeBgStart" class="form-input" style="height:40px;">
            </div>
            <div class="form-group">
              <label>Tło Koniec (Gradient)</label>
              <input type="color" id="themeBgEnd" class="form-input" style="height:40px;">
            </div>
          </div>

          <div class="form-group">
            <label>Kolor Tekstu</label>
            <input type="color" id="themeTextColor" class="form-input" style="height:40px;">
          </div>

          <button type="submit" class="btn btn-primary" style="width:100%;">Zapisz Motyw</button>
        </form>
      </div>

      <div class="admin-panel">
        <h2>Przypisz Moderatora</h2>
        <div class="form-group">
          <label for="assignCategory">Wybierz kategorię</label>
          <select id="assignCategory" class="form-select">
            <option value="">Wybierz kategorię...</option>
          </select>
        </div>
        <div class="form-group">
          <label for="assignModerator">Wybierz moderatora</label>
          <select id="assignModerator" class="form-select">
            <option value="">Wybierz moderatora...</option>
          </select>
        </div>
        <button id="assignBtn" class="btn btn-primary" style="margin-top: 10px;">Przypisz</button>

        <div id="assignmentsList">
          <p style="margin-top: 20px; color: rgba(255,255,255,0.5);">Wybierz kategorię, aby zobaczyć przypisanych
            moderatorów.</p>
        </div>
      </div>
    </div>

    <div class="admin-panel" style="margin-top: 40px;">
      <h2 style="color: #FFD700;">👥 Zarządzanie Użytkownikami</h2>
      <p style="color: #aaa; margin-bottom: 20px;">Zmieniaj role użytkowników. Moderatorzy pojawią się na liście w
        sekcji powyżej.</p>

      <div id="usersListLoading" class="loading">Ładowanie użytkowników...</div>
      <div id="usersManageList" style="overflow-x: auto;"></div>
    </div>

  </div>

  <script type="module" src="admin-categories.js"></script>
  <script type="module" src="/theme-manager.js"></script>
  <%- include('partials/footer') %>
</body>

</html>